"Product" -> "CartRemovalNotice" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
"User" -> "Order" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
