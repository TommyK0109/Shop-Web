"Order" -> "OrderItem" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
"Product" -> "OrderItem" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
"Seller" -> "OrderItem" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
"Shipment" -> "OrderItem" [dir=both, arrowtail="teeodot", arrowhead="crowodot", taillabel="0..1", headlabel="0..*"];
"Order" -> "Shipment" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
