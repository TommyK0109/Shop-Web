digraph Storefront {
 graph [rankdir=TB, bgcolor="white", fontname="Arial", fontsize=25, label="STOREFRONT  /  ENTITY RELATIONSHIP DIAGRAM", labelloc=t, labeljust=l, pad="0.4", nodesep="0.55", ranksep="0.9", splines=spline, compound=false];
 node [shape=plain,fontname="Arial",fontsize=12];
 edge [color="#8c9aac",penwidth=1.15,arrowsize=0.75,fontname="Arial",fontsize=10,labeldistance=1.5];
 "User" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e8eefc" ALIGN="LEFT"><FONT COLOR="#344a86" POINT-SIZE="15"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">UserRole</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">tokenVersion</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR></TABLE>>];
"EmailToken" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e8eefc" ALIGN="LEFT"><FONT COLOR="#344a86" POINT-SIZE="15"><B>EmailToken</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">userId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT">tokenHash</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">purpose</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">expiresAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">DateTime</FONT></TD></TR></TABLE>>];
"Seller" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e8eefc" ALIGN="LEFT"><FONT COLOR="#344a86" POINT-SIZE="15"><B>Seller</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK,UQ</FONT></TD><TD ALIGN="LEFT">userId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">businessName</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">SellerStatus</FONT></TD></TR></TABLE>>];
"SellerPaymentMethod" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e8eefc" ALIGN="LEFT"><FONT COLOR="#344a86" POINT-SIZE="15"><B>SellerPaymentMethod</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK,UQ</FONT></TD><TD ALIGN="LEFT">sellerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">bankBin</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">accountNumber</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR></TABLE>>];
"Address" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e8eefc" ALIGN="LEFT"><FONT COLOR="#344a86" POINT-SIZE="15"><B>Address</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">userId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">line1</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR></TABLE>>];
"Category" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e0f4ef" ALIGN="LEFT"><FONT COLOR="#1f6c5a" POINT-SIZE="15"><B>Category</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT">slug</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR></TABLE>>];
"Product" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e0f4ef" ALIGN="LEFT"><FONT COLOR="#1f6c5a" POINT-SIZE="15"><B>Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">sellerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">categoryId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">priceCents</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">stockQty</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">ProductStatus</FONT></TD></TR></TABLE>>];
"ProductImage" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e0f4ef" ALIGN="LEFT"><FONT COLOR="#1f6c5a" POINT-SIZE="15"><B>ProductImage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">productId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">url</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR></TABLE>>];
"Cart" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#fff1d9" ALIGN="LEFT"><FONT COLOR="#8c641c" POINT-SIZE="15"><B>Cart</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK,UQ</FONT></TD><TD ALIGN="LEFT">userId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR></TABLE>>];
"CartItem" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#fff1d9" ALIGN="LEFT"><FONT COLOR="#8c641c" POINT-SIZE="15"><B>CartItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">cartId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">productId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">UQ (cartId,productId)</FONT></TD></TR></TABLE>>];
"CartRemovalNotice" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#fff1d9" ALIGN="LEFT"><FONT COLOR="#8c641c" POINT-SIZE="15"><B>CartRemovalNotice</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">cartId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">productId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">seenAt</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">DateTime?</FONT></TD></TR></TABLE>>];
"Order" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#ffe7ec" ALIGN="LEFT"><FONT COLOR="#8f3f51" POINT-SIZE="15"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">userId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">shippingAddressId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">totalCents</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">OrderStatus</FONT></TD></TR></TABLE>>];
"OrderItem" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#ffe7ec" ALIGN="LEFT"><FONT COLOR="#8f3f51" POINT-SIZE="15"><B>OrderItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">orderId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">productId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">sellerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">shipmentId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">quantity</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">unitPriceCents</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR></TABLE>>];
"Shipment" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#ffe7ec" ALIGN="LEFT"><FONT COLOR="#8f3f51" POINT-SIZE="15"><B>Shipment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">orderId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">sellerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">ShipmentStatus</FONT></TD></TR></TABLE>>];
"Payment" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#ffe7ec" ALIGN="LEFT"><FONT COLOR="#8f3f51" POINT-SIZE="15"><B>Payment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">orderId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">sellerId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">amountCents</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT">reference</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">PaymentStatus</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">UQ (orderId,sellerId)</FONT></TD></TR></TABLE>>];
"Review" [label=<<TABLE BORDER="1" COLOR="#ccd5e0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#efe8fc" ALIGN="LEFT"><FONT COLOR="#665096" POINT-SIZE="15"><B>Review</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">productId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT">userId</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#516078" POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT">rating</TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b" POINT-SIZE="11">Int</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#64748b" POINT-SIZE="10">UQ (productId,userId)</FONT></TD></TR></TABLE>>];
 subgraph cluster_identity { label="ACCOUNTS & SELLERS"; fontsize=12; fontcolor="#344a86"; color="#dbe2eb"; style="rounded"; margin=20; "User"; "Seller"; "SellerPaymentMethod"; "Address"; "EmailToken"; }
subgraph cluster_catalog { label="CATALOG"; fontsize=12; fontcolor="#1f6c5a"; color="#dbe2eb"; style="rounded"; margin=20; "Category"; "Product"; "ProductImage"; }
subgraph cluster_cart { label="CART"; fontsize=12; fontcolor="#8c641c"; color="#dbe2eb"; style="rounded"; margin=20; "Cart"; "CartItem"; "CartRemovalNotice"; }
subgraph cluster_orders { label="ORDERS & PAYMENTS"; fontsize=12; fontcolor="#8f3f51"; color="#dbe2eb"; style="rounded"; margin=20; "Order"; "OrderItem"; "Shipment"; "Payment"; }
subgraph cluster_reviews { label="REVIEWS"; fontsize=12; fontcolor="#665096"; color="#dbe2eb"; style="rounded"; margin=20; "Review"; }
 "User" -> "EmailToken" [dir=both, arrowtail="teetee", arrowhead="crowodot", taillabel="1", headlabel="0..*"];
