{
  "name": "storefront",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:generate": "npm run prisma:generate --workspace server",
    "db:migrate": "npm exec --workspace server -- prisma migrate deploy",
    "db:seed": "npm run build --workspace shared && npm run seed --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "typecheck:server": "npm exec --workspace server -- tsc --noEmit",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ]
}
