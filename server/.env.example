# Required local configuration. npm run setup:local creates private JWT secrets.
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/storefront?schema=public"
JWT_ACCESS_SECRET="replace-with-generated-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-generated-refresh-secret-at-least-32-characters"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PORT=5201
CLIENT_ORIGIN="http://localhost:5200"
CLIENT_URL="http://localhost:5200"
TRUST_PROXY_HOPS=0

# Optional. Empty keys use Turnstile test keys in development; internet is required.
TURNSTILE_SECRET_KEY=""

# Optional email delivery. Leave blank for basic local signup/login.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional image uploads. Catalog images from the seed need no Cloudinary account.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Experimental assistant is disabled in the default local setup.
RAG_ENABLED=false
RAG_GENERATION_ENABLED=false
GEMINI_API_KEY=""
RAG_GEMINI_FREE_TIER_CONFIRMED=false
